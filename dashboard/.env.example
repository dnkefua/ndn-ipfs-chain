# API backend URL (Cloud Run in production; localhost:3000 for local Docker Compose dev)
NEXT_PUBLIC_API_URL=https://ndn-api-1037328355027.us-west1.run.app

# Optional: allow the Models page to call HuggingFace API directly from the browser.
# Leave blank in production — prefer using the server-side /v1/models proxy which reads HF_API_KEY from the API server's env.
NEXT_PUBLIC_HF_API_KEY=
