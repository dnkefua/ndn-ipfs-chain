# NDN IPFS Chain - Production Environment Configuration
# Copy this to .env.production and fill in actual values

# Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:password@db-host:5432/ndnipfs
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# Redis
REDIS_URL=redis://:password@redis-host:6379/0
REDIS_CACHE_TTL=3600

# IPFS & Cluster
KUBO_API_URL=http://kubo:5001
CLUSTER_API_URL=http://cluster:9094
IPFS_GATEWAY_URL=https://gateway.ndnipfs.link
IPFS_TIMEOUT=30000

# Security
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRY=7d
API_KEY_PREFIX=ndn_live_
ENCRYPTION_KEY=your-aes-256-key-base64-encoded

# HTTPS/TLS
HTTPS_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# CORS
CORS_ORIGIN=https://ndnanalytics.com,https://app.ndnanalytics.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Email (for notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@ndnanalytics.com

# Stripe Integration (for billing)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Web3 / Smart Contracts
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
POLYGON_RPC_URL=https://polygon-rpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Filecoin
FILECOIN_NETWORK=mainnet
FILECOIN_BOOST_API=https://boost.ndnanalytics.com/api
FILECOIN_NODE_URL=https://api.node.glif.io

# AWS (if using ECS)
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-west-2.amazonaws.com

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://ndnipfs-backups/production

# Feature Flags
FEATURE_ENCRYPTION=true
FEATURE_FILECOIN_DEALS=true
FEATURE_SMART_CONTRACT_TRIGGERS=true
FEATURE_ANALYTICS=true
FEATURE_BILLING=true

# Support & Feedback
SUPPORT_EMAIL=support@ndnanalytics.com
FEEDBACK_URL=https://feedback.ndnanalytics.com
DOCS_URL=https://docs.ndnanalytics.com

# HuggingFace
HF_API_KEY=your-huggingface-api-key